<?xml version="1.0" encoding="utf-8"?>
<!--
    RPI5_CAR: custom home screen content, included by both car_launcher.xml layouts.
    A system health panel at the top left, with a "Send command" button below it on the left
    and a "Receive data" button on the right.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/system_health_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rpi5_home_margin"
        android:layout_marginTop="@dimen/rpi5_home_margin"
        android:fontFamily="monospace"
        android:textColor="@android:color/white"
        android:textSize="@dimen/rpi5_system_health_text_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <Button
        android:id="@+id/send_command_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rpi5_button_side_margin"
        android:layout_marginTop="@dimen/rpi5_home_margin"
        android:minWidth="@dimen/rpi5_button_min_width"
        android:text="@string/rpi5_send_command"
        android:textSize="@dimen/rpi5_button_text_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/system_health_text"/>

    <Button
        android:id="@+id/receive_data_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/rpi5_button_side_margin"
        android:minWidth="@dimen/rpi5_button_min_width"
        android:text="@string/rpi5_receive_data"
        android:textSize="@dimen/rpi5_button_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/send_command_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
